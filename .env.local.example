# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)

# Supabase → Project Settings → API Keys (publishable key: sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# import 스크립트 전용 (RLS 우회). 절대 NEXT_PUBLIC_ 접두사를 붙이거나 프론트에서 쓰지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 네이버 클라우드 플랫폼 → Maps → Application → 인증 정보
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# Geocoding 서버 호출용 (서버 전용, NEXT_PUBLIC_ 금지)
NAVER_MAP_CLIENT_SECRET=
